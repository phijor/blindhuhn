cabal-version:      3.4
name:               Blindhuhn
version:            0.1.0.0
synopsis:           Auch ein blindes Huhn findet mal ein Korn
-- description:
license:            MIT
license-file:       LICENSE
author:             Philipp Joram
maintainer:         mail@phijor.me
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
      Blindhuhn
      Blindhuhn.Backend
      Blindhuhn.DefTree
      Blindhuhn.Index
      Blindhuhn.Version
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.16.4.0
      , Agda ^>=2.6.3
      , aeson ^>=2.0.3.0
      , package-version ^>=0.3
      , deepseq
      , containers
      , filepath
      , text ^>=1.2.5.0
      , uri-encode ^>=1.5.0.7
    hs-source-dirs:   src
    default-language: GHC2021

executable Blindhuhn
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.16.4.0,
        Blindhuhn

    hs-source-dirs:   app
    default-language: GHC2021

test-suite Blindhuhn-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.16.4.0,
        Blindhuhn,
        aeson ^>=2.0.3.0,
        text ^>=1.2.5.0
